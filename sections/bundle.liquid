<div class="page-width">
{% assign bundle_handle = product.metafields.custom.bundle_product %}
{% if bundle_handle %}
  {% assign bundle = all_products[bundle_handle] %}
  <h3>Bundle with {{ bundle.title }}</h3>
  <div class="bundle-section">
    <div class="bundle-inner-left">
    {% render 'product-slider', product: bundle %}
    </div>
<div class="bundle-inner-right">
  <h1 class="bundle-title">{{ bundle.title }}</h1>

  <div class="bundle-pricing">
    <h2 class="bundle-price">{{ bundle.price | money }}</h2>
    {% if bundle.compare_at_price > bundle.price %}
      <h2 class="bundle-compare">{{ bundle.compare_at_price | money }}</h2>
    {% endif %}
  </div>

  <form method="post" action="/cart/add" id="bundle-form-{{ bundle.id }}">
    <input type="hidden" name="id" id="bundle-variant-id-{{ bundle.id }}" value="{{ bundle.selected_or_first_available_variant.id }}">

    {% assign size_option_index = -1 %}
    {% assign color_option_index = -1 %}

    {% for option in bundle.options_with_values %}
      {% if option.name contains 'Size' %}
        {% assign size_option_index = forloop.index0 %}
      {% endif %}
      {% if option.name contains 'Color' %}
        {% assign color_option_index = forloop.index0 %}
      {% endif %}
    {% endfor %}

    {% if size_option_index != -1 %}
      <h3 for="bundle-size-select-{{ bundle.id }}">Size</h3>
      <select name="id" id="bundle-size-select-{{ bundle.id }}" class="bundle-select">
        {% assign seen_sizes = '' %}
        {% for variant in bundle.variants %}
          {% assign size_value = variant.options[size_option_index] %}
          {% unless seen_sizes contains size_value %}
            {% assign seen_sizes = seen_sizes | append: size_value | append: ',' %}
            <option value="{{ variant.id }}">{{ size_value }}</option>
          {% endunless %}
        {% endfor %}
      </select>
    {% endif %}

    {% if color_option_index != -1 %}
      <h3>Color</h3>
      <div class="bundle-color-swatches" id="bundle-color-swatches-{{ bundle.id }}">
        {% assign seen_colors = '' %}
        {% for variant in bundle.variants %}
          {% assign color_value = variant.options[color_option_index] %}
          {% unless seen_colors contains color_value %}
            {% assign seen_colors = seen_colors | append: color_value | append: ',' %}
            <div
              class="color-swatch"
              style="background-color: {{ color_value | downcase }};"
              title="{{ color_value }}"
              data-variant-id="{{ variant.id }}">
            </div>
          {% endunless %}
        {% endfor %}
      </div>
    {% endif %}

    <button type="submit" class="bundle-add-btn">Add to Cart</button>
  </form>
</div>


  </div>
{% endif %}
</div>

{% style %}
.bundle-section {
    width: 100%;
    height: fit-content;
    display: flex;
    gap: 4.5rem;
}

.bundle-inner-left {
    max-width: 50%;
}

/* Bundle Right Styling */

.bundle-inner-right {
  font-family: inherit;
  display: flex;
  flex-direction: column;
  gap: 0.8rem;
  max-width: 320px;
}

.bundle-inner-right h1, .bundle-inner-right h2 {
    margin: 0px;
}

.bundle-inner-right h2 {
   font-size: 18px;
}

.bundle-inner-right h3 {
    margin-bottom: 0.4rem;
    margin-top: 0px;
}

.bundle-pricing {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}


.bundle-compare {
  text-decoration: line-through;
  color: #888;
}

.bundle-select {
  width: 100%;
  padding: 0.4rem 0.6rem;
  border: 1px solid #ccc;
  border-radius: 4px;
  font-size: 0.95rem;
  margin-bottom: 1rem;
  font-size: 12px;
  height: 4rem;
}

.bundle-color-swatches {
  display: flex;
  gap: 1rem;
  margin-bottom: 2rem;
}

.color-swatch {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  border: 1px solid #ddd;
  cursor: pointer;
  transition: border 0.2s ease, transform 0.2s ease;
}

.color-swatch:hover {
  border-color: #000;
  transform: scale(1.1);
}

.bundle-add-btn {
  background-color: #111;
  color: #fff;
  border: none;
  padding: 0.75rem;
  font-size: 1.5rem;
  cursor: pointer;
  margin-top: 0.5rem;
  transition: background 0.2s ease;
  min-height: 4.5rem;
  width:100%;
}

.bundle-add-btn:hover {
  background-color: #333;
}


{% endstyle %}