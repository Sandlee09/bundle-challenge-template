<div class="page-width">
{% assign bundle_handle = product.metafields.custom.bundle_product %}
{% if bundle_handle %}
  {% assign bundle = all_products[bundle_handle] %}
  <h3>Bundle with {{ bundle.title }}</h3>
  <div class="bundle-section">
    <div class="bundle-inner-left">
    {% render 'product-slider', product: bundle %}
    </div>
<div class="bundle-inner-right">
  <h1 class="bundle-title">{{ bundle.title }}</h1>

  <div class="bundle-pricing">
    <h2 class="bundle-price">{{ bundle.price | money }}</h2>
    {% if bundle.compare_at_price > bundle.price %}
      <h2 class="bundle-compare">{{ bundle.compare_at_price | money }}</h2>
    {% endif %}
  </div>

  <form method="post" action="/cart/add" id="bundle-form-{{ bundle.id }}">
    <input type="hidden" name="id" id="bundle-variant-id-{{ bundle.id }}" value="{{ bundle.selected_or_first_available_variant.id }}">

    {% assign size_option_index = -1 %}
    {% assign color_option_index = -1 %}

    {% for option in bundle.options_with_values %}
      {% if option.name contains 'Size' %}
        {% assign size_option_index = forloop.index0 %}
      {% endif %}
      {% if option.name contains 'Color' %}
        {% assign color_option_index = forloop.index0 %}
      {% endif %}
    {% endfor %}

    {% if size_option_index != -1 %}
      <h3 for="bundle-size-select-{{ bundle.id }}">Size</h3>
      <select name="options[Size]" id="bundle-size-select-{{ bundle.id }}" class="bundle-select">
        {% assign seen_sizes = '' %}
        {% for variant in bundle.variants %}
          {% assign size_value = variant.options[size_option_index] %}
          {% unless seen_sizes contains size_value %}
            {% assign seen_sizes = seen_sizes | append: size_value | append: ',' %}
            <option value="{{ size_value }}">{{ size_value }}</option>
          {% endunless %}
        {% endfor %}
      </select>
    {% endif %}

    {% if color_option_index != -1 %}
      <h3>Color</h3>
      <input type="hidden" name="options[Color]" id="bundle-color-input-{{ bundle.id }}" value="{{ bundle.selected_or_first_available_variant.options[color_option_index] }}">
      <div class="bundle-color-swatches" id="bundle-color-swatches-{{ bundle.id }}">
        {% assign seen_colors = '' %}
        {% for variant in bundle.variants %}
          {% assign color_value = variant.options[color_option_index] %}
          {% unless seen_colors contains color_value %}
            {% assign seen_colors = seen_colors | append: color_value | append: ',' %}
            <div
              class="color-swatch {% if forloop.first %}active{% endif %}"
              style="background-color: {{ color_value | downcase }};"
              title="{{ color_value }}"
              data-color="{{ color_value }}">
            </div>
          {% endunless %}
        {% endfor %}
      </div>
    {% endif %}

    <button type="submit" class="bundle-add-btn">Add to Cart</button>
  </form>
</div>


  </div>
{% endif %}
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const bundleId = {{ bundle.id | json }};
  const form = document.getElementById('bundle-form-' + bundleId);
  const variantIdInput = document.getElementById('bundle-variant-id-' + bundleId);
  const sizeSelect = document.getElementById('bundle-size-select-' + bundleId);
  const colorInput = document.getElementById('bundle-color-input-' + bundleId);
  const colorSwatches = document.querySelectorAll('#bundle-color-swatches-' + bundleId + ' .color-swatch');
  
  const variants = {{ bundle.variants | json }};
  
  function findVariant(size, color) {
    return variants.find(v => {
      const matchSize = !size || v.options.includes(size);
      const matchColor = !color || v.options.includes(color);
      return matchSize && matchColor;
    });
  }
  
  function updateVariant() {
    const selectedSize = sizeSelect ? sizeSelect.value : null;
    const selectedColor = colorInput ? colorInput.value : null;
    const variant = findVariant(selectedSize, selectedColor);
    
    if (variant) {
      variantIdInput.value = variant.id;
    }
  }
  
  // Color swatch click handler
  colorSwatches.forEach(swatch => {
    swatch.addEventListener('click', function() {
      colorSwatches.forEach(s => s.classList.remove('active'));
      this.classList.add('active');
      
      const color = this.getAttribute('data-color');
      if (colorInput) {
        colorInput.value = color;
      }
      updateVariant();
    });
  });
  
  // Size select change handler
  if (sizeSelect) {
    sizeSelect.addEventListener('change', updateVariant);
  }
});
</script>

{% style %}
.bundle-section {
    width: 100%;
    height: fit-content;
    display: flex;
    gap: 4.5rem;
}

.bundle-inner-left {
    max-width: 50%;
}

/* Bundle Right Styling */

.bundle-inner-right {
  font-family: inherit;
  display: flex;
  flex-direction: column;
  gap: 1.2rem;
  width: 100%;
}

.bundle-inner-right h1, .bundle-inner-right h2 {
    margin: 0px;
}

.bundle-inner-right h2 {
   font-size: 18px;
}

.bundle-inner-right h3 {
    margin-bottom: 0.4rem;
    margin-top: 0px;
}

.bundle-pricing {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}


.bundle-compare {
  text-decoration: line-through;
  color: #888;
}

.bundle-select {
  width: 100%;
  padding: 0.4rem 0.6rem;
  border: 1px solid #ccc;
  border-radius: 4px;
  font-size: 0.95rem;
  margin-bottom: 1rem;
  font-size: 12px;
  height: 4rem;
}

.bundle-color-swatches {
  display: flex;
  gap: 1rem;
  margin-bottom: 2rem;
}

.color-swatch {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  border: 1px solid #ddd;
  cursor: pointer;
  transition: border 0.2s ease, transform 0.2s ease;
}

.color-swatch:hover {
  border-color: #000;
  transform: scale(1.1);
}

.color-swatch.active {
  border: 1px solid #000;
  transform: scale(1.15);
}

.bundle-add-btn {
  background-color: #111;
  color: #fff;
  border: none;
  padding: 0.75rem;
  font-size: 1.5rem;
  cursor: pointer;
  margin-top: 0.5rem;
  transition: background 0.2s ease;
  min-height: 4.5rem;
  width:100%;
  font-family: inherit;
}

.bundle-add-btn:hover {
  background-color: #333;
}


{% endstyle %}