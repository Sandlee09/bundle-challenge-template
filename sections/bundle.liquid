
{% assign bundle_handle = product.metafields.custom.bundle_product %}
{% if bundle_handle %}
  {% assign bundle = all_products[bundle_handle] %}
  <div class="bundle-section">
    <h3>Bundle with {{ bundle.title }}</h3>
    {% render 'product-slider', product: bundle %}
    <p>{{ bundle.price | money }}</p>
    <a href="{{ bundle.url }}" class="btn">View bundle</a>
  </div>
{% endif %}



{% schema %}
{
  "name": "Bundle Product Section",
  "settings": [
    {
      "type": "product",
      "id": "selected_product",
      "label": "Select a bundle product"
    }
  ],
  "presets": [
    {
      "name": "Custom Product Section"
    }
  ]
}
{% endschema %}