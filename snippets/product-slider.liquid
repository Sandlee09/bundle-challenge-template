{% comment %}
  Snippet: product-slider.liquid
  Usage: {% render 'product-slider', product: product %}
{% endcomment %}

{% if product and product.images.size > 0 %}
  <div class="swiper mySwiper relative">
    <div class="swiper-wrapper">
      {% for image in product.images %}
        <div class="swiper-slide">
          <img
            src="{{ image | img_url: '800x' }}"
            alt="{{ product.title | escape }}"
            loading="lazy"
            class="w-full object-cover"
          >
        </div>
      {% endfor %}
    </div>

    <!-- Navigation buttons -->
    <div class="swiper-button-prev custom-swiper-btn"></div>
    <div class="swiper-button-next custom-swiper-btn"></div>

    <!-- Pagination -->
    <div class="swiper-pagination"></div>
  </div>

<style>
  .mySwiper {
    position: relative;
    width: 100%;
    max-width: 600px;
    margin: auto;
    overflow: hidden;
  }

  .mySwiper img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .custom-swiper-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    color: white;
    background: rgba(0, 0, 0, 0.4);
    border-radius: 50%;
    width: 28px; /* smaller width */
    height: 28px; /* smaller height */
    display: flex!important;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
    font-size: 14px; /* smaller arrow icon size */
  }

  .custom-swiper-btn:hover {
    background: rgba(0, 0, 0, 0.6);
    transform: translateY(-50%) scale(1.1);
  }

  .swiper-button-prev.custom-swiper-btn {
    left: 8px;
  }

  .swiper-button-next.custom-swiper-btn {
    right: 8px;
  }

  .swiper-button-next:after, .swiper-button-prev:after {
    font-size: 1.5rem!important;
}

  .swiper-pagination {
    bottom: 8px !important;
  }
</style>


  <script>
    document.addEventListener('DOMContentLoaded', function() {
      new Swiper('.mySwiper', {
        loop: true,
        slidesPerView: 1,
        spaceBetween: 10,
        navigation: {
          nextEl: '.swiper-button-next',
          prevEl: '.swiper-button-prev',
        },
        pagination: {
          el: '.swiper-pagination',
          clickable: true,
        },
        autoplay: {
          delay: 3000, // 3 seconds
          disableOnInteraction: false, // keeps autoplay after manual swipe
        },
        speed: 600, // smooth transition
      });
    });
  </script>
{% else %}
  <p>No images available for this product.</p>
{% endif %}
